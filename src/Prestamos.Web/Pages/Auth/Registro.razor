@page "/registro"
@inject ApiCliente Api
@inject SesionUsuario Sesion
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Registro · Préstamos ITM</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-6">
    <MudItem xs="12" sm="8" md="6">
        <MudPaper Class="pa-6" Elevation="1">
            <h1 class="mud-typography mud-typography-h5 mb-1">Crear cuenta</h1>
            <MudText Color="Color.Secondary" Class="mb-4">Para estudiantes y docentes de la institución </MudText>

            <AlertaError Problema="_error" />

            <MudTextField T="string" @bind-Value="_modelo.Nombre" Label="Nombre completo" Variant="Variant.Outlined" Class="mb-3"
                          Immediate="true" />
            <MudTextField T="string" @bind-Value="_modelo.Documento" Label="Documento" Variant="Variant.Outlined" Class="mb-3"
                          HelperText="Solo números, entre 6 y 20 dígitos" Immediate="true" />
            <MudTextField T="string" @bind-Value="_modelo.Correo" Label="Correo" Variant="Variant.Outlined"
                          InputType="InputType.Email" Class="mb-3" Immediate="true" />
            <MudSelect T="string" @bind-Value="_modelo.TipoSolicitante" Label="Soy" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="string" Value="@("Estudiante")">Estudiante</MudSelectItem>
                <MudSelectItem T="string" Value="@("Docente")">Docente</MudSelectItem>
            </MudSelect>
            <MudTextField T="string" @bind-Value="_modelo.Contrasena" Label="Contraseña" Variant="Variant.Outlined"
                          InputType="InputType.Password" Class="mb-4"
                          HelperText="Mínimo 8 caracteres, con al menos una letra y un número" Immediate="true" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="_enviando" OnClick="RegistrarAsync">
                @(_enviando ? "Creando cuenta…" : "Crear cuenta")
            </MudButton>

            <MudText Class="mt-4" Typo="Typo.body2">
                ¿Ya tienes cuenta? <MudLink Href="login">Inicia sesión</MudLink>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private readonly RegistroRequest _modelo = new() { TipoSolicitante = "Estudiante" };
    private Problema? _error;
    private bool _enviando;

    private async Task RegistrarAsync()
    {
        _enviando = true;
        _error = null;

        var registro = await Api.PostAsync<UsuarioResponse>("api/auth/registro", _modelo);
        if (!registro.Exito)
        {
            _error = registro.Problema;
            _enviando = false;
            return;
        }

        // Inicia sesión automáticamente con la cuenta recién creada
        var login = await Api.PostAsync<SesionResponse>("api/auth/login",
            new LoginRequest { Correo = _modelo.Correo, Contrasena = _modelo.Contrasena });
        _enviando = false;

        Snackbar.Add("Cuenta creada correctamente.", Severity.Success);
        if (login.Exito && login.Datos is not null)
        {
            await Sesion.IniciarAsync(login.Datos);
            Nav.NavigateTo("catalogo");
        }
        else
        {
            Nav.NavigateTo("login");
        }
    }
}