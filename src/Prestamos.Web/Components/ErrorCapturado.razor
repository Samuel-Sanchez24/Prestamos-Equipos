@* Se muestra cuando una pantalla falla (ErrorBoundary): registra el error y evita que la app se cierre *@
@inject RegistroErrores Registro

<PaginaError CodigoTexto="Error" Titulo="Algo falló en esta pantalla"
             Mensaje="El error quedó guardado en el registro. Puedes volver al inicio y seguir trabajando."
             Detalle="@Excepcion?.Message" />

@code {
    [Parameter] public Exception? Excepcion { get; set; }

    protected override void OnInitialized()
    {
        if (Excepcion is not null)
            Registro.Registrar("Interfaz", null, Excepcion.GetType().Name, Excepcion.Message);
    }
}