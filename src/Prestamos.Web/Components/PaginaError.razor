@* Vista común para la página de error y los errores capturados en la interfaz *@
@inject NavigationManager Nav

<div class="pagina-error">
    <div class="pagina-error__codigo mono">@CodigoTexto</div>
    <h1 class="mud-typography mud-typography-h5 mb-1">@Titulo</h1>
    <MudText Color="Color.Secondary" Class="mb-4">@Mensaje</MudText>

    @if (!string.IsNullOrWhiteSpace(Detalle))
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-4 pagina-error__detalle">
            <span class="mono">@Detalle</span>
        </MudPaper>
    }

    <div class="d-flex gap-2 justify-center flex-wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home"
                   OnClick="@(() => Nav.NavigateTo("", forceLoad: Recargar))">Volver al inicio</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ReportProblem"
                   Href="errores">Ver registro de errores</MudButton>
    </div>
</div>

@code {
    [Parameter] public string CodigoTexto { get; set; } = "Error";
    [Parameter] public string Titulo { get; set; } = "Ocurrió un error";
    [Parameter] public string Mensaje { get; set; } = "No se pudo completar la operación.";
    [Parameter] public string? Detalle { get; set; }

    /// <summary>Recarga la aplicación al volver (necesario tras un error de la interfaz).</summary>
    [Parameter] public bool Recargar { get; set; }
}