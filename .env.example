# Obligatoria: clave para firmar los JWT (mínimo 32 caracteres)
Jwt__Clave=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Opcionales: ya tienen valor en appsettings.json
ConnectionStrings__Default=Server=(localdb)\MSSQLLocalDB;Database=PrestamosDb;Trusted_Connection=True;TrustServerCertificate=True
Jwt__Emisor=PrestamosApi
Jwt__Audiencia=PrestamosWeb
Jwt__MinutosExpiracion=120
Prestamos__DiasMaximoEstudiante=180
Prestamos__DiasMaximoDocente=360
Cors__OrigenesPermitidos__0=https://localhost:7262
Cors__OrigenesPermitidos__1=http://localhost:5143
