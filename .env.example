# Copiar como .env (o usar `dotnet user-secrets`). NO subir valores reales.
# ASP.NET Core lee variables con doble guion bajo como secciones: Seccion__Clave

ConnectionStrings__Default=Server=(localdb)\MSSQLLocalDB;Database=PrestamosDb;Trusted_Connection=True;TrustServerCertificate=True
Jwt__Key=cambia-esta-clave-por-una-de-al-menos-32-caracteres
Jwt__Issuer=PrestamosApi
Jwt__Audience=PrestamosWeb
Jwt__ExpiresMinutes=60
Cors__AllowedOrigin=https://localhost:5002
